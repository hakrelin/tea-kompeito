/www/wwwlogs/tea-kompeito.com.access.log /www/wwwlogs/tea-kompeito.com.error.log /www/wwwlogs/default.access.log /www/wwwlogs/default.error.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    create 0640 nginx nginx
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 $(cat /run/nginx.pid)
    endscript
}
